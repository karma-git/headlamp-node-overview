{
  "name": "headlamp-node-overview",
  "version": "0.2.0",
  "description": "Fast node overview for Headlamp: every node and its pods on one canvas, grouped by node labels, with requests/limits/usage bars, search and tooltips",
  "scripts": {
    "start": "headlamp-plugin start",
    "build": "headlamp-plugin build",
    "format": "headlamp-plugin format",
    "lint": "headlamp-plugin lint",
    "tsc": "headlamp-plugin tsc",
    "package": "headlamp-plugin package"
  },
  "keywords": [
    "headlamp",
    "headlamp-plugin",
    "kubernetes",
    "nodes",
    "pods",
    "capacity"
  ],
  "prettier": "@headlamp-k8s/eslint-config/prettier-config",
  "eslintConfig": {
    "extends": [
      "@headlamp-k8s",
      "prettier"
    ]
  },
  "dependencies": {
    "@node-overview/core": "*"
  },
  "devDependencies": {
    "@kinvolk/headlamp-plugin": "^0.14.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/karma-git/headlamp-node-overview.git",
    "directory": "packages/headlamp-node-overview"
  },
  "homepage": "https://github.com/karma-git/headlamp-node-overview",
  "bugs": "https://github.com/karma-git/headlamp-node-overview/issues"
}
